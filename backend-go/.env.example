# Configuración por defecto para desarrollo local (backend Go).
# Copiar a .env y ajustar. NUNCA versionar secrets reales.

# dev | prod. Cualquier valor != dev (default: prod) aborta el arranque si la
# conexión usa un superusuario o un rol con BYPASSRLS (ver docs/DEPLOY_NOTES.md).
# Con dev se acepta además la cabecera X-Tenant-Slug para pruebas locales.
APP_ENV=dev

# Dirección de escucha del servidor.
HTTP_ADDR=:8080

# PostgreSQL. sslmode=disable solo para desarrollo local.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/barber?sslmode=disable
# Rol dueño del esquema para `make migrate-up` (si se omite usa DATABASE_URL).
# MIGRATE_DATABASE_URL=

# Obligatoria; mínimo 32 bytes. Generar con: openssl rand -base64 32
JWT_SECRET=

# Aplicar migraciones SQL al arrancar (true/false).
AUTO_MIGRATE=true

# Orígenes permitidos para CORS, separados por coma (vacío = sin CORS).
# Producción: https://mateo-404.github.io
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174

# Tenant al que pertenecen los Hosts desconocidos en rutas públicas.
DEFAULT_TENANT_SLUG=default

# Seed del administrador inicial (solo se crea si el tenant no tiene admins).
ADMIN_SEED=true
ADMIN_SEED_EMAIL=admin@admin.com
ADMIN_SEED_PASSWORD=admin1234

# Límite de intentos de login por IP y minuto.
LOGIN_RATE_LIMIT_PER_MINUTE=5

# Límite de reservas públicas (POST /turnos) por IP y minuto.
TURNO_RATE_LIMIT_PER_MINUTE=30

# Confiar en X-Forwarded-For para el rate limit. SOLO activar detrás de un
# proxy de confianza que SOBRESCRIBA la cabecera (si no, se puede evadir el
# límite falsificándola). Por defecto false.
TRUST_PROXY_HEADERS=false

# Timeout por consulta SQL (formato Go, ej 10s).
STATEMENT_TIMEOUT=10s

# Tamaño máximo del body de una request (bytes).
MAX_REQUEST_BODY=1048576

# Tamaño máximo del pool y timeout de conexión (opcionales).
POOL_MAX_CONNS=10
CONN_TIMEOUT=5s
