      "patch": {
        "name": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
      }
    },
    {
      "name": "logo_https",
      "patch": {
        "logo": "https://cdn.example.com/logo.png"
      }
    },
    {
      "name": "logo_data_png",
      "patch": {
        "logo": "data:image/png;base64,iVBORw0KGgo="
      }
    },
    {
      "name": "radius_zero",
      "patch": {
        "shape": {
