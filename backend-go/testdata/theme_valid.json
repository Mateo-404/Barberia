      }
    },
    {
      "name": "light_mode",
      "patch": {
        "mode": "light"
      }
    },
    {
      "name": "auto_mode",
      "patch": {
        "mode": "auto"
      }
    },
    {
      "name": "custom_preset",
      "patch": {
        "preset": "custom"
      }
    },
    {
      "name": "uppercase_brand_is_normalized",
      "patch": {
