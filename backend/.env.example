# PostgreSQL credentials for Barberia backend
# Copy this file to .env and fill in your actual values.
# WARNING: .env is in .gitignore — never commit real secrets.
#
# How to load these variables:
#   Option A (IntelliJ): Run > Edit Configurations > Environment variables
#     > paste the key=value lines (one per line, no export prefix).
#   Option B (terminal):
#     export $(grep -v '^#' backend/.env | xargs) && ./mvnw spring-boot:run

DB_URL=jdbc:postgresql://localhost:5432/barber
DB_USER=changeme
DB_PASSWORD=changeme

# JWT secret (min 32 bytes for HS256)
# JWT_SECRET=your-256-bit-secret-key-here

# Seed admin credentials (creado automaticamente al primer inicio si la DB está vacía)
# ADMIN_SEED_EMAIL=admin@barberia.com
# ADMIN_SEED_PASSWORD=miPasswordSegura123
